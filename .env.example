# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# App notifications: run `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the morning job. Any long random string; also add it as a GitHub secret.
CRON_SECRET=

# Your app's address, e.g. https://stylista.vercel.app (used in notifications and texts)
APP_URL=

# Optional: text messages with the collage (twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
